# Copy this file to ".env" and fill it in. NEVER commit .env to git.

# --- Schwab developer app (https://developer.schwab.com -> Dashboard -> your app) ---
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must match your app's callback URL EXACTLY (no trailing slash).
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# Which account the bot may trade (plain account number). Needed if you have more
# than one Schwab account. The bot shares it safely with your own investing: it only
# touches what it bought and never buys stocks you already own.
SCHWAB_ACCOUNT_NUMBER=

# --- The real-money safety switch ---
# Even after a desk earns LIVE status, no real order is sent unless this says exactly: true
LIVE_TRADING_ENABLED=false
