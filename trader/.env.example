# Copy this file to ".env" and fill it in. NEVER commit .env to git or share it.

# --- Alpaca (https://app.alpaca.markets) -------------------------------------
# PAPER keys: switch the dashboard to "Paper Trading", then API Keys -> Generate.
# The bot's paper phase trades here with fake money (reset the paper account to $1,000).
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
# LIVE keys: only needed once a desk earns real money. Leave empty until then.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# --- Charles Schwab (optional, for later) ------------------------------------
# From https://developer.schwab.com -> Dashboard -> your app.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must match your app's callback URL EXACTLY (no trailing slash).
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# Which Schwab account the bot may trade (needed if you have more than one).
SCHWAB_ACCOUNT_NUMBER=

# --- Your phone (optional): a private Telegram bot for alerts and commands ------
# Set up from Kestrel's Setup screen. The chat id is filled in when you pair your phone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- The real-money safety switch --------------------------------------------
# Even after a desk earns LIVE status, no real order is sent unless this says exactly: true
LIVE_TRADING_ENABLED=false
