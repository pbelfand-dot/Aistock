# Copy this file to ".env" and fill it in. NEVER commit .env to git.

# --- Schwab developer app (https://developer.schwab.com -> Dashboard -> your app) ---
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must match your app's callback URL EXACTLY (no trailing slash).
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# Which account the bot may trade (plain account number). Use a SEPARATE
# account just for the bot so it can never touch your long-term holdings.
SCHWAB_ACCOUNT_NUMBER=

# --- The real-money safety switch ---
# Even after the bot earns LIVE status, it will not send a real order unless
# this says exactly: true
LIVE_TRADING_ENABLED=false
